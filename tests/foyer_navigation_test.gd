extends "res://tests/foyer_native_fixture.gd"
## Actual touch-driven circuits. No path/actor substitute or recovery teleport.
const PROFILE := "/tmp/vaultbound-foyer-navigation/profile.json"
var actors: Array[Node3D] = []
var previous := {}
var travelled := {}
var raised := {}
var intermediate := {}
var initial_recoveries := {}
var sampled_frames := 0
var maximum_step := 0.0
var tracking := false
var touch_owned := false
var pet_baseline := {}
var pet_frames := 0
var pet_maximum_step := 0.0
var pet_previous := Vector3.ZERO
var pet_previous_frame := -1
var pet_cadence_valid := true
var pet_identity_valid := true
var pet_hidden_clear_run := 0
var pet_maximum_hidden_clear_run := 0
var pet_middle := false
var pet_upper := false
var pet_distance := 0.0
var pet_floor_valid := true
var pet_budget_valid := true
var toggled_while_walking := false
var observer: Node
var route_phase := "setup"
var observed_recoveries := {}
var previous_pet_state := {}

class PetObserver extends Node:
	var fixture: WeakRef
	func _process(_delta: float) -> void:
		var fixture_owner: Object = fixture.get_ref()
		if is_instance_valid(fixture_owner): fixture_owner.call("_sample_pet")

func _initialize() -> void:
	Engine.max_fps = 120
	suite_name = "VAULTBOUND FOYER NATIVE NAVIGATION"
	_run.call_deferred()

func _run() -> void:
	var flying := OS.get_cmdline_user_args().has("--fly")
	if await prepare_foyer(PROFILE, flying):
		await _journey()
	tracking = false
	_release_touch()
	if is_instance_valid(observer): observer.free()
	if is_instance_valid(game): await retire_game()
	finish()

func _journey() -> void:
	actors.assign([player, game.party.members.guardian, game.party.members.mystic])
	await frames(12)
	for actor: Node3D in actors:
		previous[actor.name] = actor.global_position
		travelled[actor.name] = 0.0
		raised[actor.name] = false
		intermediate[actor.name] = false
		if actor != player: initial_recoveries[actor.name] = actor.recovery_count
	pet_baseline = pet.presentation_snapshot().duplicate(true)
	previous_pet_state = pet_baseline.duplicate(true)
	observed_recoveries = initial_recoveries.duplicate()
	pet_previous = pet.global_position
	observer = PetObserver.new()
	observer.fixture = weakref(self)
	observer.process_priority = 1000000
	root.add_child(observer)
	tracking = true
	check(game.party.issue_command(&"follow"), "The existing Follow command starts the real foyer party")
	var identity := player.get_instance_id()
	# Coordinates are independent expectations from the architectural contract,
	# not generated by the scene's navigation graph or its success predicates.
	for start_side: float in [1.0, -1.0]:
		for actor: Node3D in actors: intermediate[actor.name] = false
		if not await _walk_points(_ascent(start_side), "ascend " + str(start_side)): return
		if not check(await _wait_for(func() -> bool: return _all_upper(), 10.0), "Both actual followers reach the upper gallery on foot"): return
		for actor: Node3D in actors:
			check(intermediate[actor.name] and actor.global_position.y > 3.2,
				actor.name + " physically crosses intermediate stair elevations on ascent")
		if not check(await _wait_for(func() -> bool: return pet.visible and pet.global_position.y > 3.2, 6.0), "The real selected pet follows onto the upper gallery"): return
		if not check(await _walk_to(Vector3(0, 3.4, -15.2), 7.0), "Player walks across the rear gallery bridge"): return
		if not check(await _walk_to(Vector3(-start_side * 6.2, 3.4, -15.2), 7.0), "Player reaches the opposite upper landing"): return
		var descending := _ascent(-start_side)
		descending.reverse()
		for actor: Node3D in actors: intermediate[actor.name] = false
		if not await _walk_points(descending, "descend " + str(-start_side)): return
		if not check(await _walk_to(Vector3(0, 0, 8), 7.0), "Player returns to the ground arrival aisle without a reset"): return
		if not check(await _wait_for(func() -> bool: return _all_ground(), 10.0), "Both followers physically complete the full stair circuit"): return
		for actor: Node3D in actors: check(intermediate[actor.name], actor.name + " crosses intermediate elevations on descent")
		if not check(await _wait_for(func() -> bool: return pet.visible and pet.global_position.y < 0.2, 6.0), "Selected pet returns to ground through the walked route"): return
	await _hold_and_retreat()
	await _lower_edge_orders()
	check(player.get_instance_id() == identity and toggled_while_walking, "Camera switching during the stair journey keeps the same gameplay character")
	for actor: Node3D in actors:
		check(float(travelled[actor.name]) > 120.0 and bool(raised[actor.name]), actor.name + " completes long native journeys on both storeys")
		if actor != player:
			check(actor.recovery_count == initial_recoveries[actor.name], actor.name + " never uses recovery relocation during either stair circuit")
			check(actor.navigator.replan_count < sampled_frames / 5.0 + 30.0, actor.name + " keeps navigation replans below physics frequency")
	check(maximum_step < 0.35, "Continuous physical sampling contains no hidden actor teleport")
	var final_pet: Dictionary = pet.presentation_snapshot()
	check(final_pet.placement_count == pet_baseline.placement_count and final_pet.recovery_count == pet_baseline.recovery_count,
		"Pet stair following never substitutes a hidden recovery or new placement")
	check(pet_frames > 100 and pet_cadence_valid and pet_identity_valid and pet_floor_valid and pet_budget_valid,
		"Every observed pet render tick keeps world identity, supported floor and bounded trail/query state")
	check(pet_distance > 100.0 and pet_middle and pet_upper and pet_maximum_step <= 0.28001,
		"Selected pet traverses intermediate and upper heights through bounded visible movement")
	check(pet_maximum_hidden_clear_run <= 16, "Pet does not remain hidden on a clear visible route to mask navigation failure")
	tracking = false
	assert_secured_unchanged("Physical stair routes and commands")
	print("FOYER NAVIGATION METRICS: ", JSON.stringify({"physics_frames": sampled_frames, "maximum_actor_step": maximum_step,
		"distances": travelled, "pet_idle_frames": pet_frames, "pet_distance": pet_distance,
		"pet_maximum_step": pet_maximum_step, "pet_clear_hidden_max_frames": pet_maximum_hidden_clear_run,
		"pet_recoveries": int(final_pet.recovery_count) - int(pet_baseline.recovery_count),
		"pet_placements": int(final_pet.placement_count) - int(pet_baseline.placement_count), "pet_maximum_queries": final_pet.maximum_queries_seen}))
	await actual_hall_round_trip()

func _ascent(side: float) -> Array[Vector3]:
	var result: Array[Vector3] = [Vector3(6.2, 0, 9), Vector3(8.2, 0.36, 9),
		Vector3(9.4246, 0.36, 8.7564), Vector3(10.4627, 0.36, 8.0627), Vector3(11.1564, 0.36, 7.0246), Vector3(11.4, 0.36, 5.8),
		Vector3(11.4, 1.12, 1.8), Vector3(11.4, 1.88, -2.2), Vector3(11.4, 2.64, -6.2), Vector3(11.4, 3.4, -10.2),
		Vector3(11.1564, 3.4, -11.4246), Vector3(10.4627, 3.4, -12.4627), Vector3(9.4246, 3.4, -13.1564), Vector3(8.2, 3.4, -13.4),
		Vector3(6.2, 3.4, -13.4), Vector3(6.2, 3.4, -15.2)]
	for index in range(result.size()):
		var point := result[index]
		point.x *= side
		result[index] = point
	return result

func _walk_points(points: Array[Vector3], label: String) -> bool:
	for point: Vector3 in points:
		if not check(await _walk_to(point, 7.0), "Actual touch movement reaches " + label + " point " + str(point)): return false
	return true

func _walk_to(goal: Vector3, timeout: float) -> bool:
	route_phase = "walk to " + str(goal)
	var surface: Control = game.hud.surface
	var center: Vector2 = surface._joystick_center()
	touch(surface, 91, center, true)
	touch_owned = surface._joystick_finger == 91
	if not touch_owned: return false
	var reached := false
	for index in range(ceili(timeout * Engine.physics_ticks_per_second)):
		await physics_frame
		_sample_motion()
		var offset: Vector3 = goal - player.global_position
		if Vector2(offset.x, offset.z).length() < 0.27 and absf(offset.y) < 0.25:
			reached = true
			break
		offset.y = 0.0
		var direction := offset.normalized()
		var right: Vector3 = game.camera_rig.camera.global_basis.x
		var back: Vector3 = game.camera_rig.camera.global_basis.z
		right.y = 0.0
		back.y = 0.0
		var stick := Vector2(direction.dot(right.normalized()), direction.dot(back.normalized()))
		drag(surface, 91, center + stick * 70.0, stick * 70.0)
		if not toggled_while_walking and player.global_position.y > 1.1 and player.global_position.y < 2.6:
			input_hub.request_action(&"camera_toggle")
			toggled_while_walking = true
	_release_touch()
	for index in range(3):
		await physics_frame
		_sample_motion()
	if not reached: print("FOYER WALK DIAGNOSTIC: goal=", goal, " player=", player.global_position)
	return reached

func _release_touch() -> void:
	if touch_owned and is_instance_valid(game): touch(game.hud.surface, 91, game.hud.surface._joystick_center(), false)
	touch_owned = false
	if is_instance_valid(input_hub): input_hub.set_touch_move(Vector2.ZERO)

func _wait_for(predicate: Callable, timeout: float) -> bool:
	for index in range(ceili(timeout * Engine.physics_ticks_per_second)):
		await physics_frame
		_sample_motion()
		if predicate.call(): return true
	return false

func _sample_motion() -> void:
	if not tracking: return
	sampled_frames += 1
	for actor: Node3D in actors:
		var step: float = actor.global_position.distance_to(previous[actor.name])
		if actor != player:
			if actor.recovery_count != observed_recoveries[actor.name] or step > 0.35:
				print("FOYER ACTOR RECOVERY TRACE: ", JSON.stringify({"phase": route_phase, "command": game.party.command,
					"actor": actor.name, "previous": previous[actor.name], "position": actor.global_position, "leader": player.global_position,
					"step": step, "recoveries": actor.recovery_count, "brain_state": actor.brain.state, "destination": actor.brain.destination,
					"path_failed": actor.navigator.path_failed, "stuck": actor.navigator.stuck_seconds, "path": str(actor.navigator.path)}))
			observed_recoveries[actor.name] = actor.recovery_count
		maximum_step = maxf(maximum_step, step)
		travelled[actor.name] += step
		previous[actor.name] = actor.global_position
		intermediate[actor.name] = bool(intermediate[actor.name]) or (actor.global_position.y > 0.7 and actor.global_position.y < 2.9)
		raised[actor.name] = bool(raised[actor.name]) or actor.global_position.y > 3.2

func _sample_pet() -> void:
	if not tracking or not is_instance_valid(pet): return
	var frame := Engine.get_process_frames()
	pet_cadence_valid = pet_cadence_valid and (pet_previous_frame < 0 or frame == pet_previous_frame + 1)
	pet_previous_frame = frame
	pet_identity_valid = pet_identity_valid and pet.get_parent() == foyer and game._pet_presenter.get_ref() == pet
	var step := pet.global_position.distance_to(pet_previous)
	pet_distance += step
	pet_maximum_step = maxf(pet_maximum_step, step)
	pet_previous = pet.global_position
	pet_frames += 1
	pet_middle = pet_middle or (pet.global_position.y > 0.7 and pet.global_position.y < 2.9)
	pet_upper = pet_upper or pet.global_position.y > 3.2
	var state: Dictionary = pet.presentation_snapshot()
	if state.recovering != previous_pet_state.get("recovering", false) or state.placement_count != previous_pet_state.get("placement_count", 0) or step > 0.28001:
		print("FOYER PET RECOVERY TRACE: ", JSON.stringify({"phase": route_phase, "command": game.party.command,
			"position": pet.global_position, "leader": player.global_position, "leader_grounded": player.is_on_floor(),
			"step": step, "stuck": pet._stuck, "previous_state": previous_pet_state, "state": state,
			"last_leader": pet.trail._last_leader, "trail_point": pet.trail.points[pet.trail.cursor] if pet.trail.cursor < pet.trail.points.size() else Vector3.INF}))
	previous_pet_state = {"recovering": state.recovering, "placement_count": state.placement_count,
		"recovery_count": state.recovery_count, "position": pet.global_position, "stuck": pet._stuck, "trail": state.trail.duplicate(true)}
	pet_budget_valid = pet_budget_valid and state.maximum_queries_seen <= 6 and state.trail.point_count <= 128
	# Independent queries do not consume or reset the presenter's own budget.
	var ray := PhysicsRayQueryParameters3D.create(pet.global_position + Vector3.UP * 0.4, pet.global_position - Vector3.UP * 0.4, 1)
	ray.collide_with_areas = false
	var space := foyer.get_world_3d().direct_space_state
	var hit := space.intersect_ray(ray)
	pet_floor_valid = pet_floor_valid and not hit.is_empty() and hit.collider.is_in_group("city_navigation_surfaces")
	var sight := PhysicsRayQueryParameters3D.create(player.global_position + Vector3.UP * 0.7, pet.global_position + Vector3.UP * 0.5, 1)
	sight.collide_with_areas = false
	pet_hidden_clear_run = pet_hidden_clear_run + 1 if not pet.visible and space.intersect_ray(sight).is_empty() else 0
	pet_maximum_hidden_clear_run = maxi(pet_maximum_hidden_clear_run, pet_hidden_clear_run)

func _all_upper() -> bool:
	for actor: Node3D in actors:
		if actor.global_position.y < 3.2 or actor.global_position.distance_to(player.global_position) > 5.0: return false
	return true

func _all_ground() -> bool:
	for actor: Node3D in actors:
		if actor.global_position.y > 0.2 or actor.global_position.distance_to(player.global_position) > 5.0: return false
	return true

func _hold_and_retreat() -> void:
	if not await _walk_points(_ascent(1.0), "hold ascent"): return
	if not check(await _wait_for(func() -> bool: return _all_upper(), 10.0), "Party regroups upstairs before Hold"): return
	check(game.party.issue_command(&"hold"), "Existing Hold command is accepted upstairs")
	var held := {}
	for actor: Node3D in actors:
		if actor != player: held[actor.name] = actor.global_position
	var descent := _ascent(1.0)
	descent.reverse()
	if not await _walk_points(descent, "held companion descent"): return
	if not check(await _walk_to(Vector3(0, 0, 8), 7.0), "Leader physically leaves held companions upstairs"): return
	for actor: Node3D in actors:
		if actor != player:
			check(actor.global_position.distance_to(held[actor.name]) < 1.0 and actor.global_position.y > 3.2, actor.name + " respects its upper-floor Hold position")
	check(game.party.issue_command(&"retreat"), "Existing Retreat command is accepted from the ground floor")
	check(await _wait_for(func() -> bool: return _all_ground(), 25.0), "Both held companions walk down the actual stair route under Retreat")
	check(game.party.issue_command(&"follow"), "Follow resumes after the stair retreat")

func _lower_edge_orders() -> void:
	# This ground position is physically in front of the raised rear plinth.
	if not check(await _walk_to(Vector3(0, 0, -10.9), 12.0), "Leader walks to the lower Trophy/plinth edge"): return
	for heading in range(8):
		route_phase = "lower edge heading " + str(heading)
		var angle := float(heading) * TAU / 8.0
		player._facing = Vector3(sin(angle), 0, cos(angle))
		var order: StringName = &"follow" if heading % 2 == 0 else &"retreat"
		check(game.party.issue_command(order), "Lower-edge command accepts heading %d" % heading)
		var transition := await _settle_lower_edge_formation(order, heading)
		check(transition.ground and transition.recovery_unchanged, "Followers remain on the actual ground storey without recovery throughout heading %d" % heading)
		check(transition.converged, "Followers regroup within five metres and stop in formation within eight seconds at heading %d" % heading)
		# Retain the original 90-frame ground/six-metre invariant after actual
		# settling. A new order has a reaction delay, and the retained Trophy Hall
		# pillars can require a ground detour outside that radius while in transit.
		# Proximity alone before the next decision cannot establish formation.
		var stayed_ground := true
		var reported: Dictionary = {}
		for index in range(90):
			await physics_frame
			_sample_motion()
			for actor: Node3D in actors:
				if actor != player:
					var within_ground: bool = actor.global_position.y < 0.3 and actor.global_position.distance_to(player.global_position) < 6.0
					if not within_ground and not reported.has(actor.name):
						reported[actor.name] = true
						print("FOYER LOWER EDGE FAILURE: ", JSON.stringify({"heading": heading, "frame": index, "actor": actor.name,
							"position": actor.global_position, "leader": player.global_position, "distance": actor.global_position.distance_to(player.global_position),
							"resolved_goal": actor.brain.destination, "path": str(actor.navigator.path)}))
					stayed_ground = stayed_ground and within_ground
		check(stayed_ground, "Highest-floor sampling cannot send a ground follower onto the rear gallery at heading %d" % heading)

func _settle_lower_edge_formation(order: StringName, heading: int) -> Dictionary:
	var maximum_reaction := 0.0
	var peaks: Dictionary = {}
	for actor: Node3D in actors:
		if actor == player: continue
		maximum_reaction = maxf(maximum_reaction, actor.data.decision_interval + actor.data.reaction_jitter)
		peaks[actor.name] = actor.global_position.distance_to(player.global_position)
	# The current Guardian/Mystic settings require 32 consecutive settled frames.
	# Observe at least a full decision window plus the original 90-frame sample,
	# so a delayed intention cannot make the previous heading look successful.
	var stable_frames_needed := ceili(maximum_reaction * Engine.physics_ticks_per_second)
	var minimum_observation_frames := stable_frames_needed + 90
	var stable_frames := 0
	var result := {"heading": heading, "elapsed_frames": 0, "peaks": peaks, "ground": true, "recovery_unchanged": true, "converged": false}
	for index in range(8 * Engine.physics_ticks_per_second):
		await physics_frame
		_sample_motion()
		result.elapsed_frames = index + 1
		var settled := true
		for actor: Node3D in actors:
			if actor == player: continue
			var distance: float = actor.global_position.distance_to(player.global_position)
			peaks[actor.name] = maxf(float(peaks[actor.name]), distance)
			result.ground = result.ground and actor.global_position.y < 0.3
			result.recovery_unchanged = result.recovery_unchanged and actor.recovery_count == initial_recoveries[actor.name]
			var speed := Vector2(actor.velocity.x, actor.velocity.z).length()
			var offset: Vector3 = actor.global_position - actor.brain.destination
			var stopping_distance := 1.0 if order == &"retreat" else 0.8
			var frame_travel: float = actor.data.move_speed / float(Engine.physics_ticks_per_second)
			settled = settled and distance < 5.0 and Vector2(offset.x, offset.z).length() <= stopping_distance + frame_travel \
				and speed < 0.1 and not actor.brain.wants_movement and actor.brain.state == &"formation"
		stable_frames = stable_frames + 1 if settled else 0
		if index + 1 >= minimum_observation_frames and stable_frames >= stable_frames_needed:
			result.converged = true
			break
	print("FOYER LOWER EDGE CONVERGENCE: ", JSON.stringify(result))
	if not result.ground or not result.recovery_unchanged or not result.converged:
		for actor: Node3D in actors:
			if actor == player: continue
			print("FOYER LOWER EDGE TRANSIT FAILURE: ", JSON.stringify({"heading": heading, "actor": actor.name,
				"position": actor.global_position, "leader": player.global_position, "resolved_goal": actor.brain.destination,
				"velocity": actor.velocity, "state": actor.brain.state, "moving": actor.brain.wants_movement,
				"path": str(actor.navigator.path), "city_route": str(actor.navigator._city_route), "city_index": actor.navigator._city_route_index,
				"recoveries": actor.recovery_count, "decision_remaining": actor.brain.decision_remaining, "rng_state": str(actor.brain._rng.state)}))
	return result
