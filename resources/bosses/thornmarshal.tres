[gd_resource type="Resource" script_class="VaultBossDefinition" load_steps=7 format=3]
[ext_resource type="Script" path="res://scripts/enemies/boss_definition.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/enemies/bosses/sentinel.tscn" id="2"]
[ext_resource type="Resource" path="res://resources/bosses/attacks/sentinel_cleave.tres" id="a0"]
[ext_resource type="Resource" path="res://resources/bosses/attacks/sentinel_charge.tres" id="a1"]
[ext_resource type="Resource" path="res://resources/bosses/attacks/sentinel_stomp.tres" id="a2"]
[ext_resource type="Script" path="res://scripts/enemies/boss_attack_definition.gd" id="attack_script"]
[resource]
script = ExtResource("1")
id = &"thornmarshal"
display_name = "Thornmarshal"
controller_family = &"sentinel"
scene = ExtResource("2")
available = true
content_version = 2
arena_profile_id = &"rootbound_sentinel_arena"
reward_profile_id = &"thornmarshal"
discovery_id = &"thornmarshal"
visual_profile_id = &"thornmarshal"
allowed_variant_ids = Array[StringName]([&"none", &"ascendant_pattern"])
stats = {"max_health": 440.0, "armor": 0.08, "move_speed": 1.8, "detection_range": 11.0, "leash_radius": 12.0, "movement_radius": 4.5, "phase_threshold": 0.4, "phase_transition_time": 1.6}
phase_one_patterns = Array[StringName]([&"sentinel_cleave", &"sentinel_charge", &"sentinel_stomp"])
phase_two_patterns = Array[StringName]([&"sentinel_charge", &"sentinel_cleave", &"sentinel_stomp", &"sentinel_cleave"])
attacks = Array[ExtResource("attack_script")]([ExtResource("a0"), ExtResource("a1"), ExtResource("a2")])
