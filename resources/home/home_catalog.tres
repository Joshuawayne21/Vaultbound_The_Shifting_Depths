rooms = Array[Dictionary]([{"id": "foyer", "label": "Grand Foyer", "requirement": "Your Personal Sanctuary", "kind": "home", "minimum": 1, "available": true, "destination": "personal_sanctuary"}, {"id": "trophy_hall", "label": "Trophy Hall", "requirement": "Your Personal Sanctuary", "kind": "home", "minimum": 1, "available": true, "destination": "collection_hall"}, {"id": "pet_conservatory", "label": "Pet Conservatory", "requirement": "Own one Spiritweaving pet", "kind": "owned_pets", "minimum": 1, "available": true, "destination": "home_conservatory"}, {"id": "armory", "label": "Armory", "requirement": "Reach character level three", "kind": "level", "minimum": 3, "available": true, "destination": "home_armory"}, {"id": "companion_hall", "label": "Companion Hall", "requirement": "Recruit one adventurer", "kind": "recruits", "minimum": 1, "available": true, "destination": "home_companion_hall"}, {"id": "relic_library", "label": "Relic Library", "requirement": "Complete one expedition", "kind": "completed", "minimum": 1, "available": true, "destination": "home_relic_library"}, {"id": "personal_chamber", "label": "Personal Chamber", "requirement": "Reach character level five", "kind": "level", "minimum": 5, "available": true, "destination": "home_personal_chamber"}, {"id": "wardrobe", "label": "Wardrobe", "requirement": "Earn Abyss Explorer: complete three expeditions", "kind": "abyss_explorer", "minimum": 1, "available": true, "destination": "home_wardrobe"}, {"id": "rooftop_garden", "label": "Rooftop Garden", "requirement": "Clear dungeon depth three", "kind": "cleared_depth", "minimum": 3, "available": true, "destination": "home_rooftop_garden"}])
