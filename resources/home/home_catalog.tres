[gd_resource type="Resource" script_class="VaultHomeCatalog" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/home_catalog.gd" id="1"]

[resource]
script = ExtResource("1")
version = 1
styles = Array[Dictionary]([{"id": "royal_azure", "label": "Royal Azure", "requirement": "Your Personal Sanctuary", "kind": "home", "minimum": 1, "color": Color(0.16, 0.35, 0.65, 1)}, {"id": "enchanted_forest", "label": "Enchanted Forest", "requirement": "Own one Spiritweaving pet", "kind": "owned_pets", "minimum": 1, "color": Color(0.15, 0.55, 0.36, 1)}, {"id": "runic_obsidian", "label": "Runic Obsidian", "requirement": "Complete one expedition", "kind": "completed", "minimum": 1, "color": Color(0.24, 0.23, 0.32, 1)}, {"id": "celestial_violet", "label": "Celestial Violet", "requirement": "Clear dungeon depth three", "kind": "cleared_depth", "minimum": 3, "color": Color(0.49, 0.28, 0.72, 1)}])
